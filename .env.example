# Copy to .env for local (non-Docker) runs. Docker Compose sets its own URLs.

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# MongoDB connection string and database name
MONGO_URL=mongodb://localhost:27017
MONGO_DB=cohort

# Redis connection string (rate limiter + content cache)
REDIS_URL=redis://localhost:6379/0

# ---- Worker ----
# Claim loops per worker process (scale further with --scale worker=N)
WORKER_CONCURRENCY=2
# Seconds an idle loop waits before checking for due jobs again
WORKER_POLL_SECONDS=1
# Seconds a claim stays exclusive; a crashed worker's job is retried after this.
# Must be longer than the longest stage.
LEASE_SECONDS=60
# Attempts per stage before the document is marked failed
MAX_ATTEMPTS=3
# Retry backoff base: waits are base*1, base*2, base*4 ...
RETRY_BASE_SECONDS=2

# Simulated stage durations (seconds) and failure chance (0.0-1.0)
PROCESSING_MIN_SECONDS=10
PROCESSING_MAX_SECONDS=20
ENRICHING_MIN_SECONDS=5
ENRICHING_MAX_SECONDS=15
STAGE_FAILURE_RATE=0.1

# ---- Rate limit & content cache (Redis) ----
# Documents a user may have in progress (queued/processing/enriching) at once
MAX_ACTIVE_PER_USER=3
# An idle user's slot set expires after this many seconds
RATE_LIMIT_KEY_TTL_SECONDS=86400
# Reservations younger than this are never treated as stale
RATE_LIMIT_GRACE_SECONDS=60
# How long a computed summary+tags stays cached
CACHE_TTL_SECONDS=86400